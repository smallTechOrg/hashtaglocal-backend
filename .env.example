GOOGLE_APPLICATION_CREDENTIALS=gcs-key.json
FIREBASE_CREDENTIALS_PATH=/opt/hashtaglocal-backend/firebase-key.json

# Event scrape service
EVENTS_SCRAPE_URL=https://staging.api.smalltech.in/webscrapestaging/api/v1/scrape
EVENTS_SCRAPE_CRON=0 */5 * * * *
GOOGLE_MAPS_API_KEY=replacewithrealcreds
# All AI (quizzes, bulletin texts, feed moderation) uses the provider saved in the Ops Dashboard
# (AI Provider page). The keys below are a DEPRECATED fallback used only while nothing is saved there;
# the Groq and Gemini ones will be removed. Comma-separated, best model first.
QUIZ_ANTHROPIC_KEYS=key1,key2,key3
QUIZ_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5
QUIZ_GROQ_KEYS=key1,key2,key3,key4,key5
QUIZ_GROQ_MODELS=
QUIZ_GEMINI_KEYS=key1,key2,key3,key4,key5
QUIZ_GEMINI_MODELS=gemini-4-neon,gemini-3.1-flash-lite
# Encrypts the AI key saved from the Ops Dashboard (AI Provider page). Base64 of 32 random bytes:
#   openssl rand -base64 32
# Keep it secret and stable: changing it makes the saved key unreadable (re-enter it in the dashboard).
AI_CONFIG_ENCRYPTION_KEY=
# Optional: allow dashboard endpoints on private/loopback IPs (SSRF guard; default false).
# AI_CONFIG_ALLOW_PRIVATE_ENDPOINTS=false
# Optional: how long each instance caches the saved config (default 30s).
# AI_CONFIG_CACHE_TTL=30s
GEONAMES_USERNAME=yourusernamehere
GOOGLE_STORAGE_BUCKET_NAME=yourbucketnamehere
APP_FORWARDED_PREFIX=/localstaging
# This backend's own public base URL — sent to the scraper as X-Backend-Url so FETCH_EVENTS
# dedupes against the right database (staging vs production share one scraper deployment).
APP_SELF_BASE_URL=https://staging.api.smalltech.in/localstaging

# Account deletion admin notification (also used for the bulletin weather generation failure
# alert, unless BULLETIN_ALERT_ADMIN_EMAIL / BULLETIN_ALERT_FROM_EMAIL are set separately)
ACCOUNT_DELETION_ADMIN_EMAIL=admin@example.com
ACCOUNT_DELETION_FROM_EMAIL=admin@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_FROM=admin@example.com
SPRING_MAIL_SMTP_LOCALHOST=example.com

# Test database (used by src/test/resources/application-test.yaml)
TEST_DB_URL=jdbc:postgresql://localhost:5432/hashtaglocaltest
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=changeme
